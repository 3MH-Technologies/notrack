# =============================================================================
# notrack SDK — environment template
# Copy to .env and fill in. Never commit real secrets.
# © 3MH Technologies — https://3mh.pages.dev/ — https://t.me/j49_c
# =============================================================================

# Service base URL
NOTRACK_BASE=https://notrack.ai

# Optional: browser-style cookie string for higher limits: "k1=v1; k2=v2"
# Never commit a real value.
NOTRACK_COOKIE=

# Default model: A (fast) | B (general) | C (balanced, default) | F (synthesis)
NOTRACK_MODEL=C

# Default persona: normal | creative | precise | concise | socratic | tutor | coder
NOTRACK_PERSONA=normal

# Agent turns per dispatch (default 6)
NOTRACK_MAX_TURNS=6

# Read timeout in seconds (default 120)
NOTRACK_TIMEOUT=120

# Rate-limit retry attempts (default 5)
NOTRACK_MAX_ATTEMPTS=5
